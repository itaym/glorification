{
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsdoc": "^65.0.0",
        "eslint-plugin-n": "^18.4.0",
        "eslint-plugin-prefer-arrow-functions": "^3.10.2",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.12.0"
    },
    "description": "Glorification ESLint config: a modern coding style — 4 spaces, single quotes, no semicolons, 120 columns — with optional sorting, aliases and JSDoc extras.",
    "exports": {
        ".": "./index.js",
        "./aliases": "./aliases.js",
        "./base": "./base.js",
        "./jsdoc": "./jsdoc.js",
        "./sorting": "./sorting.js",
        "./ts": "./ts.js"
    },
    "files": [
        "*.js",
        "README.md"
    ],
    "keywords": [
        "eslint",
        "eslint-config",
        "eslintconfig",
        "glorification",
        "style"
    ],
    "license": "MIT",
    "name": "@glorification/eslint-config",
    "peerDependencies": {
        "eslint": "^9.0.0 || ^10.0.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "typescript": ">=5.0.0",
        "typescript-eslint": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "eslint-plugin-perfectionist": {
            "optional": true
        },
        "typescript": {
            "optional": true
        },
        "typescript-eslint": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "directory": "packages/eslint-config",
        "type": "git",
        "url": "git+https://github.com/itaym/glorification.git"
    },
    "scripts": {
        "prepack": "node -e \"require('fs').copyFileSync('../../README.md', 'README.md')\""
    },
    "type": "module",
    "version": "0.1.1"
}
